{
  // LearWizAI API Worker — single worker serving /api/* and the SPA assets.
  // Top-level config = production. env.staging / env.dev = other environments.
  // See docs/superpowers/specs/2026-09-11-step1-foundation-design.md §5-§6.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learwizai-api",
  "main": "src/index.ts",
  // Pinned to the max date supported by the installed workerd/minifare to keep local test output pristine.
  // Remote edge accepts any past date; bump together with wrangler upgrades.
  "compatibility_date": "2025-09-06",
  "vars": { "ENVIRONMENT": "production" },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learwizai-db-prod",
      "database_id": "70b040b9-a20d-4195-89a3-9d01e833dcfb",
      "migrations_dir": "../../db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "2296c05f37e24600a1d977188530bb2c" }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "learwizai-docs-prod" }],
  "env": {
    "staging": {
      "name": "learwizai-api-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learwizai-db-staging",
          "database_id": "4544579b-f7c2-4a29-b2b0-7f378a255679",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "5baf0bd066b74046b962ca5c435ad02c" }],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "learwizai-docs-staging" }],
    },
    "dev": {
      "name": "learwizai-api-dev",
      "vars": { "ENVIRONMENT": "dev" },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learwizai-db-dev",
          "database_id": "61a8d3b6-5eb1-4fa2-8a82-9fa04974c414",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "76fd06d21a6e4d4aafae674cadf6c05a" }],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "learwizai-docs-dev" }],
    },
  },
}
